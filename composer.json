{
    "name": "aisuvro/andcart-installer",
    "description": "A complete web installer for AndCart applications, making the setup process simple and user-friendly.",
    "license": "MIT",
    "authors": [
        {
            "name": "Rashed Zaman",
            "email": "jmrashed@gmail.com",
            "homepage": "https://github.com/jmrashed",
            "role": "Original Developer"
        },
        {
            "name": "aisuvro",
            "email": "aisuvro@example.com",
            "homepage": "https://github.com/aisuvro",
            "role": "Fork Maintainer"
        }
    ],
    "keywords": [
        "andcart",
        "laravel", 
        "installer", 
        "web installer", 
        "laravel setup", 
        "laravel installation", 
        "laravel package",
        "ecommerce installer"
    ],
    "homepage": "https://github.com/aisuvro/andcart-installer",
    "support": {
        "issues": "https://github.com/aisuvro/andcart-installer/issues",
        "source": "https://github.com/aisuvro/andcart-installer"
    },
    "require": {
        "php": ">=8.1.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Aisuvro\\AndcartInstaller\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aisuvro\\AndcartInstaller\\Providers\\LaravelInstallerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "suggest": {
        "jmrashed/laravel-core-application-service": "To extend functionality with core application services."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
